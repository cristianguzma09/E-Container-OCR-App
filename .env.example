ENVIRONMENT=local
DEBUG=true

# SQLAlchemy URL. Driver is psycopg (v3): postgresql+psycopg://...
DATABASE_URL=postgresql+psycopg://econtainer:econtainer@localhost:5432/econtainer
DATABASE_ECHO=false

# JSON array of allowed browser origins (Angular dev server by default)
CORS_ORIGINS=["http://localhost:4200"]

# Recognition. Set to "paddleocr" once requirements-ocr.txt is installed.
OCR_ENGINE=stub
OCR_LANGUAGE=en
OCR_MINIMUM_CONFIDENCE=0.3
# oneDNN speeds up CPU inference but crashes PaddlePaddle 3.3 on some CPUs.
OCR_ENABLE_MKLDNN=false
IMAGE_STORE_PATH=var/captures
